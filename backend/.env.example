# OpenRouter API Key for Pydantic AI
OPENROUTER_API_KEY=your_openrouter_api_key

# Models for the Pydantic AI reasoning agents (parser, evaluator, reporter).
# REASONING_MODEL applies to all three; a per-agent var overrides it for that
# agent only. Format: <provider>:<model> as understood by pydantic-ai.
REASONING_MODEL=openrouter:google/gemini-2.0-flash-001
# PARSER_MODEL=openrouter:google/gemini-2.0-flash-001
# EVALUATOR_MODEL=openrouter:google/gemini-2.0-flash-001
# REPORTER_MODEL=openrouter:google/gemini-2.0-flash-001

# LiveKit Cloud Configuration
LIVEKIT_URL=your_livekit_url
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# OpenAI API Key (used by LiveKit's OpenAI-backed services, if enabled)
OPENAI_API_KEY=your_openai_api_key

# LiveKit Inference voice models
# Fish Audio s2.1-pro-free is free under Fish's fair-use limits, but has no
# time-to-first-audio or availability guarantees. Override for production fallback.
# Voice-pipeline LLM (the interviewer's conversation model) uses the
# <provider>/<model> format via LiveKit Inference.
LIVEKIT_LLM_MODEL=openai/gpt-4o-mini
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_TTS_MODEL=fishaudio/s2.1-pro-free
LIVEKIT_TTS_VOICE=9a9cf47702da476aa4629e2506d4a857
LIVEKIT_TTS_LANGUAGE=en

# Backend API URL (used by the worker to fetch plans and post reports)
# This is the address the worker uses to reach the backend service.
# In docker compose, use the backend service name (e.g. http://backend:8000).
# For local non-docker runs, http://localhost:8000 works.
BACKEND_URL=http://localhost:8000

# Public domain of the frontend (REQUIRED in production, optional in development)
# Used by CORS to build the allowed-origins list. Without this set in production,
# the backend will refuse to start with: RuntimeError: DOMAIN env var is required in production
# Example: DOMAIN=https://yourdomain.com
DOMAIN=

# Environment: development | production
# Always set ENVIRONMENT=production in production deploys.
ENVIRONMENT=development

# Database location (SQLite via aiosqlite)
# Defaults to backend/data/aura.db. Mount a persistent volume here in production.
DATABASE_PATH=backend/data/aura.db

# Server-backed database (Postgres) — optional; wins over DATABASE_PATH when set.
#   postgresql+asyncpg://aura_user:pw@postgres:5432/aura
# Alembic migrations run against it at backend startup. To move data from the
# SQLite file over, see scripts/migrate_sqlite_to_postgres.py.
# DATABASE_URL=

# Redis (used for shared rate-limiting across workers / replicas)
# Leave empty in dev — the rate limiter falls back to in-memory storage.
# Set to a redis:// URL in production, e.g. redis://redis:6379/0
REDIS_URL=

# MinIO (report archival)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=reports
# Set to true when MINIO_ENDPOINT uses https:// (managed S3/MinIO with TLS).
# Leave false for local minio:9000 over plain HTTP.
MINIO_SECURE=false

# Langfuse (observability — optional, tracing disabled if unset)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
# Sentry (error monitoring)
SENTRY_DSN=

# JWT Authentication
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production. In development, a stable fallback is used if unset.
JWT_SECRET=
OAUTH_SESSION_SECRET=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin email (gets admin role on first login)
# WARNING: anyone who can log in with this email gets admin privileges.
ADMIN_EMAIL=

# Worker-to-backend shared secret
# WARNING: anyone with this key can submit reports and transcripts as the worker.
WORKER_API_KEY=

# Frontend URL (for OAuth redirect)
FRONTEND_URL=http://localhost:5173

# SendByte (transactional email: verification, welcome, password reset)
# API keys from https://sendbyte.africa — use sk_test_... keys in development.
# If either value is unset, emails are skipped (registration still works).
SENDBYTE_API_KEY=
SENDBYTE_FROM_EMAIL="Aura <no-reply@yourdomain.com>"

# Public base URL of this API used in email links (optional).
# Defaults to {FRONTEND_URL}/api in production (the nginx proxy strips /api/)
# and http://localhost:8000 in development.
# PUBLIC_API_URL=
